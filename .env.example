# MongoDB connection string. Required.
MONGODB_URI=

# Secret key used to sign session tokens (staff/customer login). Required in
# production — if unset, a weak built-in default is used which is not safe
# for a live deployment.
SESSION_SECRET=

# Credentials for the very first admin account. Used only once: on first
# login attempt, if no staff users exist yet, this account is created as
# admin. After that, manage staff accounts from the HQ Portal > Staff &
# Permissions tab instead.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Public base URL of the deployed site, used to build links in transactional
# emails (order tracking, admin alerts). On Vercel this falls back
# automatically to the deployment's VERCEL_URL if unset, so it's only
# required to set this explicitly when using a custom domain.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional: default Resend API key used only if no Email Settings have been
# configured yet from the HQ Portal > Email Config tab. Prefer configuring
# email delivery from that UI instead of this variable.
RESEND_API_KEY=
